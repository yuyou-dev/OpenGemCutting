{
  "name": "opengemcutting-preset-studio",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "OpenGemCutting crown/pavilion preset studio: preset library, parametric generators, axial transforms and cutting preview",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/run-vite-local.mjs",
    "build": "vite build",
    "preview": "node scripts/run-vite-local.mjs preview",
    "test": "node --test tests/*.test.mjs",
    "examples": "node scripts/examples.mjs",
    "validate:examples": "node scripts/validate-examples.mjs",
    "check": "npm test && npm run examples && npm run validate:examples && npm run build",
    "module:build": "vite build --config vite.module.config.mjs",
    "module:pack": "node scripts/module/pack.mjs",
    "labs:joint": "node scripts/labs-joint.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./host": "./src/adapters/host-bridge.js",
    "./studio": "./src/App.jsx"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.3"
  }
}
