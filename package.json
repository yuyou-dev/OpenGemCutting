{
  "name": "opengemcutting",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-based parametric gemstone faceting workbench for the 96-index system.",
  "license": "MIT",
  "author": "yuyou-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuyou-dev/OpenGemCutting.git"
  },
  "homepage": "https://yuyou-dev.github.io/OpenGemCutting/",
  "bugs": {
    "url": "https://github.com/yuyou-dev/OpenGemCutting/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-vite-local.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:pages": "vite build --base=/OpenGemCutting/",
    "preview": "node scripts/run-vite-local.mjs preview",
    "report:sample": "node scripts/generate-report-sample.mjs",
    "test": "node --test src/**/*.test.js",
    "check": "npm run scan:public && npm run test && npm run build && npm run test:sites",
    "scan:public": "node scripts/public-scan.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tabler/icons-react": "^3.46.0",
    "@vitejs/plugin-react": "5.0.4",
    "p5": "^2.3.2",
    "pdf-lib": "^1.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  }
}
